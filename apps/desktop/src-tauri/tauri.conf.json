{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevHub",
  "version": "0.1.2",
  "identifier": "dev.sixthsense.claude-ui",
  "build": {
    "frontendDist": "../loading",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm --filter @devhub/web dev",
    "beforeBuildCommand": "pnpm --filter @devhub/web build && pnpm --filter @devhub/desktop prepare:sidecar"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ronaks-code/devhub/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFENkNBNDY3OUYzNDU5OUQKUldTZFdUU2ZaNlJzSFRqTTZaeWNsQjhTRXdoQ2tEL1NhRnJQWGhvNko4WUVudCtPS1lEd0MzYjYK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../dist/sidecar/": "sidecar/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
