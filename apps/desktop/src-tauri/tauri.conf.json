{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude UI",
  "version": "0.1.0",
  "identifier": "dev.sixthsense.claude-ui",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @claude-ui/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Claude UI",
        "width": 1400,
        "height": 900,
        "minWidth": 920,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
