{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevHub",
  "version": "0.1.0",
  "identifier": "dev.sixthsense.claude-ui",
  "build": {
    "frontendDist": "../loading",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm --filter @devhub/web dev",
    "beforeBuildCommand": "pnpm --filter @devhub/web build && pnpm --filter @devhub/desktop prepare:sidecar"
  },
  "app": {
    "windows": [
      {
        "title": "DevHub",
        "width": 1400,
        "height": 900,
        "minWidth": 920,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 14, "y": 14 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../dist/sidecar/": "sidecar/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
