{
  "name": "devhub",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@devhub/server --filter=@devhub/web",
    "build": "turbo run build --filter=@devhub/engine --filter=@devhub/server --filter=@devhub/web",
    "tui": "pnpm --filter @devhub/tui start",
    "desktop": "pnpm --filter @devhub/desktop dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "oxlint": "1.74.0",
    "tsx": "^4.19.2",
    "turbo": "^2.9.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
