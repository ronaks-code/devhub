{
  "name": "claude-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@claude-ui/server --filter=@claude-ui/web",
    "build": "turbo run build --filter=@claude-ui/engine --filter=@claude-ui/server --filter=@claude-ui/web",
    "tui": "pnpm --filter @claude-ui/tui start",
    "desktop": "pnpm --filter @claude-ui/desktop dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.9.0",
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.5"
  }
}
